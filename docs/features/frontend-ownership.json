{
  "forbiddenBroadCodeOwnershipPatterns": [
    "web/frontend/**",
    "web/frontend/src/**",
    "web/frontend/src/*",
    "web/frontend/src/components/**",
    "web/frontend/src/routes/**"
  ],
  "rules": [
    {
      "spec": "docs/features/chat-channels.md",
      "patterns": [
        "web/frontend/src/api/channels.ts",
        "web/frontend/src/api/gateway.ts",
        "web/frontend/src/api/pico.ts",
        "web/frontend/src/components/channels/**",
        "web/frontend/src/components/chat/**",
        "web/frontend/src/features/chat/**",
        "web/frontend/src/hooks/use-gateway*",
        "web/frontend/src/hooks/use-pico-chat.ts",
        "web/frontend/src/hooks/use-sidebar-channels.ts",
        "web/frontend/src/routes/channels/**",
        "web/frontend/src/routes/index.tsx"
      ]
    },
    {
      "spec": "docs/features/session-memory.md",
      "patterns": [
        "web/frontend/src/api/sessions.ts",
        "web/frontend/src/components/logs/**",
        "web/frontend/src/hooks/use-session-history.ts",
        "web/frontend/src/routes/logs.tsx"
      ]
    },
    {
      "spec": "docs/features/tool-execution.md",
      "patterns": [
        "web/frontend/src/api/tools.ts",
        "web/frontend/src/components/agent/skill-tool-collection-route-state.ts",
        "web/frontend/src/components/agent/tools/**",
        "web/frontend/src/hooks/use-chat-models.ts",
        "web/frontend/src/routes/agent/-skills-tools-route.test.tsx",
        "web/frontend/src/routes/agent/tools*.tsx"
      ]
    },
    {
      "spec": "docs/features/mcp-integration.md",
      "patterns": [
        "web/frontend/src/api/mcp*.ts",
        "web/frontend/src/components/agent/mcp/**",
        "web/frontend/src/routes/agent/mcp*.tsx"
      ]
    },
    {
      "spec": "docs/features/skills.md",
      "patterns": [
        "web/frontend/src/api/skills.ts",
        "web/frontend/src/components/agent/hub/**",
        "web/frontend/src/components/agent/skill-tool-collection-route-state.ts",
        "web/frontend/src/components/agent/skills/**",
        "web/frontend/src/routes/agent/-skills-tools-route.test.tsx",
        "web/frontend/src/routes/agent/hub.tsx",
        "web/frontend/src/routes/agent/skills*.tsx"
      ]
    },
    {
      "spec": "docs/features/threads.md",
      "patterns": [
        "web/frontend/src/api/threads.ts",
        "web/frontend/src/store/threads.ts",
        "web/frontend/src/components/threads/**",
        "web/frontend/src/components/agent/tools/thread-policy-tab.tsx",
        "web/frontend/src/features/chat/thread-*",
        "web/frontend/src/routes/threads*"
      ]
    },
    {
      "spec": "docs/features/git-workspaces.md",
      "patterns": [
        "web/frontend/src/api/git-workspaces.ts",
        "web/frontend/src/components/agent/git-workspaces/**",
        "web/frontend/src/routes/agent/git-workspaces*.tsx"
      ]
    },
    {
      "spec": "docs/features/repository-reviews.md",
      "patterns": [
        "web/frontend/src/api/repository-reviews*.ts",
        "web/frontend/src/components/repository-reviews/**",
        "web/frontend/src/routes/-repository-reviews*.test.tsx",
        "web/frontend/src/routes/repository-reviews*.tsx"
      ]
    },
    {
      "spec": "docs/features/repository-model-evaluations.md",
      "patterns": [
        "web/frontend/src/api/model-evaluations*.ts",
        "web/frontend/src/components/model-evaluations/**",
        "web/frontend/src/routes/-model-evaluations-route.test.tsx",
        "web/frontend/src/routes/model-evaluations*.tsx"
      ]
    },
    {
      "spec": "docs/features/agent-conversations.md",
      "patterns": [
        "web/frontend/src/api/agents*.ts",
        "web/frontend/src/components/agent/agents/**",
        "web/frontend/src/routes/agent/agents*.tsx"
      ]
    },
    {
      "spec": "docs/features/model-router.md",
      "patterns": [
        "web/frontend/src/components/models/model-collections.tsx",
        "web/frontend/src/components/models/model-router*",
        "web/frontend/src/routes/models_*router*.tsx"
      ]
    },
    {
      "spec": "docs/features/account-router.md",
      "patterns": [
        "web/frontend/src/api/accounts.ts",
        "web/frontend/src/components/credentials/account-collection-route-state.ts",
        "web/frontend/src/components/credentials/account-collections.tsx",
        "web/frontend/src/components/credentials/account-router-editor-page.tsx",
        "web/frontend/src/components/credentials/account-router-validation.ts",
        "web/frontend/src/routes/accounts_.routers*.tsx"
      ]
    },
    {
      "spec": "docs/features/event-automation.md",
      "patterns": [
        "web/frontend/src/api/event-sources.ts",
        "web/frontend/src/api/events.ts",
        "web/frontend/src/api/development-workspaces.ts",
        "web/frontend/src/api/notifications.ts",
        "web/frontend/src/api/pr-lifecycle-flow.ts",
        "web/frontend/src/api/pr-lifecycle-workflow-configurations*.ts",
        "web/frontend/src/api/pr-lifecycle-repository-assignments*.ts",
        "web/frontend/src/api/pr-workspace-gates.ts",
        "web/frontend/src/api/pr-workspaces.ts",
        "web/frontend/src/app-providers.tsx",
        "web/frontend/src/components/app-sidebar.tsx",
        "web/frontend/src/components/development-workspaces/**",
        "web/frontend/src/components/events/**",
        "web/frontend/src/components/notifications/**",
        "web/frontend/src/components/pr-workspaces/**",
        "web/frontend/src/lib/pwa-notifications.ts",
        "web/frontend/src/routes/event-sources*.tsx",
        "web/frontend/src/routes/events.tsx",
        "web/frontend/src/routes/-development.test.ts",
        "web/frontend/src/routes/-development-collection-route.test.tsx",
        "web/frontend/src/routes/development.tsx",
        "web/frontend/src/routes/development_*.tsx",
        "web/frontend/src/routes/notifications.tsx",
        "web/frontend/src/routes/notifications_*.tsx",
        "web/frontend/src/routes/pull-requests*.tsx"
      ]
    },
    {
      "spec": "docs/features/workflows.md",
      "patterns": [
        "web/frontend/src/api/workflows.ts",
        "web/frontend/src/components/workflows/**",
        "web/frontend/src/routes/agent/workflows*.tsx"
      ]
    },
    {
      "spec": "docs/features/launcher-management.md",
      "patterns": [
        "web/frontend/src/api/accounts.ts",
        "web/frontend/src/api/launcher-auth.ts",
        "web/frontend/src/api/collection.ts",
        "web/frontend/src/api/models.ts",
        "web/frontend/src/api/oauth.ts",
        "web/frontend/src/api/system.ts",
        "web/frontend/src/app-providers.tsx",
        "web/frontend/src/components/app-*",
        "web/frontend/src/components/config/**",
        "web/frontend/src/components/credentials/**",
        "web/frontend/src/components/models/**",
        "web/frontend/src/components/collection/**",
        "web/frontend/src/components/shared-form.tsx",
        "web/frontend/src/components/tour/**",
        "web/frontend/src/components/ui/**",
        "web/frontend/src/hooks/use-credentials-page.ts",
        "web/frontend/src/hooks/use-collection-route-state.ts",
        "web/frontend/src/i18n/**",
        "web/frontend/src/lib/**",
        "web/frontend/src/main.tsx",
        "web/frontend/src/routes/agent.tsx",
        "web/frontend/src/routes/__root.tsx",
        "web/frontend/src/routes/config*",
        "web/frontend/src/routes/accounts*.tsx",
        "web/frontend/src/routes/credentials.tsx",
        "web/frontend/src/routes/launcher-*",
        "web/frontend/src/routes/models_*alias*.tsx",
        "web/frontend/src/store/**"
      ]
    },
    {
      "spec": "docs/features/github-copilot-subscription.md",
      "patterns": [
        "web/frontend/src/api/accounts.ts",
        "web/frontend/src/api/oauth.ts",
        "web/frontend/src/components/credentials/account-auth-editor-page.tsx",
        "web/frontend/src/components/credentials/account-collections.tsx",
        "web/frontend/src/components/credentials/account-router-editor-page.tsx",
        "web/frontend/src/hooks/use-credentials-page.ts",
        "web/frontend/src/i18n/locales/bn-in.json",
        "web/frontend/src/i18n/locales/cs.json",
        "web/frontend/src/i18n/locales/en.json",
        "web/frontend/src/i18n/locales/pt-br.json",
        "web/frontend/src/i18n/locales/zh.json"
      ]
    }
  ]
}
